# Copy this file to .env.local and fill values for local development
# Do NOT commit your real API keys.

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add site)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Slack incoming webhook URL for contact form notifications
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
